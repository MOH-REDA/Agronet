# Copy to /opt/agronet/.env.aws on EC2 and chmod 600.
# Never commit the populated file.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=http://YOUR_EC2_PUBLIC_IP
LOG_LEVEL=warning
RUN_MIGRATIONS=true

DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=agronet
DB_USERNAME=agronet
DB_PASSWORD=REPLACE_ME

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP/api/auth/facebook/callback
