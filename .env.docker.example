APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATED_BY_DOCKER_UP_SCRIPT
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_LEVEL=warning
RUN_MIGRATIONS=true

# Smart Equipment Advisor (create a free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Social login (provider secrets stay in Laravel; never prefix these with VITE_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/auth/facebook/callback

DB_DATABASE=agronet
DB_USERNAME=agronet
DB_PASSWORD=GENERATED_BY_DOCKER_UP_SCRIPT
DB_ROOT_PASSWORD=GENERATED_BY_DOCKER_UP_SCRIPT
